renderer
{
	resolution 1280 720
	windowresolution 1280 720
	maxdepth 2
	tilewidth 256
	tileheight 144
	envmapfile HDR/san_giuseppe_bridge_blurred.hdr
	envmapintensity 2.0
	#independentrendersize true
}

camera
{
	position 0.0 1.6 10.0
	lookat 0.0 1.0 -4.0
	fov 60
}

material ground
{
    color 0.7 0.7 0.7
    metallic 0.0
    roughness 0.8
}

material mirror_ball
{
    color 0.85 0.85 0.87
    metallic 1.0
    roughness 0.05
}

material gold_ball
{
    color 1.0 0.86 0.57
    metallic 1.0
    roughness 0.2
}

material copper_ball
{
    color 0.95 0.64 0.54
    metallic 1.0
    roughness 0.25
}

material rough_ball
{
    color 0.8 0.5 0.4
    metallic 0.0
    roughness 0.6
}

material slippery_cube
{
    color 0.15 0.2 0.25
    metallic 0.0
    roughness 0.08
}

material plastic_cube
{
    color 0.3 0.6 0.85
    metallic 0.0
    roughness 0.2
}

material thin_cube
{
    color 0.3 0.3 0.3
    metallic 0.0
    roughness 0.95
}

material metallic_wall
{
    color 0.9 0.85 0.75
    metallic 0.95
    roughness 0.15
}

mesh
{
    file ssr_test/unit_plane.obj
    material ground
    position 0.0 0.0 0.0
    scale 50.0 50.0 1.0
    rotation -0.7071 0.0 0.0 0.7071
}

mesh
{
    file ssr_test/orange.obj
    material mirror_ball
    position -3.0 1.0 -4.0
    scale 0.5 0.5 0.5
}

mesh
{
    file ssr_test/orange.obj
    material gold_ball
    position 0.0 1.0 -4.0
    scale 0.5 0.5 0.5
}

mesh
{
    file ssr_test/orange.obj
    material copper_ball
    position 3.0 1.0 -4.0
    scale 0.5 0.5 0.5
}

mesh
{
    file ssr_test/orange.obj
    material rough_ball
    position 0.0 1.0 -1.5
    scale 0.5 0.5 0.5
}

mesh
{
    file ssr_test/unit_cube.obj
    material slippery_cube
    position -1.0 0.5 -2.0
}

mesh
{
    file ssr_test/unit_cube.obj
    material plastic_cube
    position 1.0 0.5 -2.0
}

mesh
{
    file ssr_test/unit_cube.obj
    material thin_cube
    position 0.5 1.0 -3.0
    scale 0.001 2.0 2.0
}

mesh
{
    file ssr_test/unit_plane.obj
    material metallic_wall
    position 0.0 0.0 -10.0
    scale 20.0 10.0 1.0
}