    //    float pixelStep = 1.0;
    //    if (proj1.z > 0.0 && proj0.z > 0.0)
    //    {
    //        vec2 dUV = proj1.xy -proj0.xy;
    //        float duLen = length(dUV) * float(pc.width);
    //        pixelStep = max(1.0, duLen);
    //    }
    //
    //    float stride = max(0.5 * maxDist / float(maxSteps), 0.001) * pc.strideScale;
    //
    //    // start marching from a small offset to avoid self hit
    //    float t =0.01;
    //    bool hit = false;
    //    float hitT = 0.0;
    //    vec2 hitUV = vec2(0.0);
    //
    //    for (int i = 0; i < maxSteps && t < maxDist; ++i)
    //    {
    //        vec3 samplePos = viewPos + R_view * t;
    //        vec3 proj = projectViewPosToScreenUV(samplePos);
    //        if (proj.z < 0.0)
    //        {
    //            t+=stride;
    //            continue;
    //        }
    //        vec2 suv = proj.xy;
    //        if (any(lessThan(suv, vec2(0.0))) || any(greaterThan(suv, vec2(1.0))))
    //        {
    //            t+=stride;
    //            continue;
    //        }
    //
    //        // scene distance at suv
    //        float sceneDist = sampleSceneViewDist(suv);
    //        float sampleDist = proj.z;
    //
    //        // if scene is closer than this sample point (with tolerance thickness), hit
    //        if (sceneDist < sampleDist + thickness)
    //        {
    //            // hit found between previous tPrev and t
    //            hit = true;
    //            hitT = t;
    //            hitUV = suv;
    //            // refine with binary search
    //            float t0 = max(0.0, t - stride);
    //            float t1 = t;
    //            for (int b = 0; b < binaryIters; ++b)
    //            {
    //                float tm = 0.5 * (t0 + t1);
    //                vec3 pm = viewPos + R_view * tm;
    //                vec3 projm = projectViewPosToScreenUV(pm);
    //                if (projm.z <= 0.0)
    //                {
    //                    t0 = tm;
    //                    continue;
    //                }
    //                vec2 suvm = projm.xy;
    //                float sceneDistm = sampleSceneViewDist(suvm);
    //                float sampleDistm = projm.z;
    //                if (sceneDistm < sampleDistm + thickness)
    //                {
