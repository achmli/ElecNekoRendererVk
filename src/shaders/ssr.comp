    //            hitUV = projHit.xy;
    //            break;
    //        }
    //        t += stride;
    //    }
    // estimate a small world-space start offset to avoid self-hit
    float minWorldStep = 0.02;// fallback
    {
        // try to estimate how many world units correspond to ~1 pixel
        vec3 p1 = viewPos + R_view * 0.05;
        vec3 proj1 = projectViewPosToScreenUV(p1);
        vec3 proj0 = projectViewPosToScreenUV(viewPos);
        if (proj1.z > 0.0 && proj0.z > 0.0) {
            float pixelDelta = length((proj1.xy - proj0.xy) * vec2(pc.width, pc.height));
            if (pixelDelta > 1e-6) {
                float scale = 1.0 / pixelDelta;
                minWorldStep = clamp(0.05 * scale, 0.005, 0.5);
            } else {
                minWorldStep = 0.02;
            }
        } else {
            minWorldStep = 0.02;
        }
    }

    // start a bit away from surface (must be < maxDist)
    float t = max(0.01, minWorldStep);

    // marching params
    float maxDist = pc.maxDistance;
    int maxSteps = pc.maxSteps;
    float thickness = pc.thickness;
    int binaryIters = pc.binaryIters;
    float stride = max(0.5 * maxDist / float(maxSteps), 0.001) * pc.strideScale;

    // Pixel-space rejection radius to avoid sampling very near the original pixel
    float rejectPixelRadius = 4.0;// try 1..4

    bool hit = false;
    float hitT = 0.0;
    vec2 hitUV = vec2(0.0);

    for (int i = 0; i < maxSteps && t < maxDist; ++i)
    {
        vec3 samplePos = viewPos + R_view * t;
        vec3 proj = projectViewPosToScreenUV(samplePos);
        if (proj.z <= 0.0) { t += stride; continue; }
        vec2 suv = proj.xy;
        if (suv.x < 0.0 || suv.x > 1.0 || suv.y < 0.0 || suv.y > 1.0) { t += stride; continue; }

        // reject self-projection (pixel distance)
        float pxDist = length((suv - uv) * vec2(pc.width, pc.height));
        if (pxDist < rejectPixelRadius) {
            t += stride;
            continue;
        }

        // sample scene positive view-space distance at suv
        float sceneDist = sampleSceneViewDist(suv);// positive distance (must match proj.z convention)
        float sampleDist = proj.z;// positive distance

        // conservative hit test: scene must be significantly closer than the sample
        if (sceneDist < sampleDist - thickness)
        {
            // found a hit between t - stride and t -> binary refine
            float t0 = max(0.0, t - stride);
            float t1 = t;
            for (int b = 0; b < binaryIters; ++b)
            {
                float tm = 0.5 * (t0 + t1);
                vec3 pm = viewPos + R_view * tm;
                vec3 projm = projectViewPosToScreenUV(pm);
                if (projm.z <= 0.0) { t0 = tm; continue; }
                vec2 suvm = projm.xy;
                // avoid refining to a UV too close to original pixel
                float pxDistm = length((suvm - uv) * vec2(pc.width, pc.height));
                if (pxDistm < rejectPixelRadius) { t0 = tm; continue; }

                float sceneDistm = sampleSceneViewDist(suvm);
                float sampleDistm = projm.z;
                if (sceneDistm < sampleDistm - thickness) {
                    t1 = tm;
                } else {
                    t0 = tm;
                }
            }

            hitT = 0.5 * (t0 + t1);
            vec3 pHit = viewPos + R_view * hitT;
            vec3 projHit = projectViewPosToScreenUV(pHit);
            hitUV = projHit.xy;
            hit = true;
            break;
        }

        t += stride;
    }

    vec3 outColor = vec3(0.0);
    float hitMask = 0.0;

    if (hit)
    {
        outColor =sampleSceneColor(hitUV);
        hitMask=1.0;
    }
    else
    {
        vec3 R_world = viewDirToWorld(R_view);
        float mip = clamp(roughness, 0.0, 1.0) * pc.prefilterMaxMip;
        outColor = textureLod(uEnvMap, R_world, mip).rgb;
        hitMask = 0.0;
    }

    imageStore(outSSR, pix, vec4(outColor, hitMask));
}