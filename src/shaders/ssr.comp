#version 450
#extension GL_ARB_compute_shader : enable
#extension GL_ARB_separate_shader_objects : enable

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std140, binding = 0)uniform uboCamera
{
    mat4 view;
    mat4 proj;
    mat4 viewNoTrans;
    mat4 invView;
    mat4 invProj;
}camera;

layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outSSR;

layout(set = 0, binding = 2) uniform sampler2D uLitMap;
layout(set = 0, binding = 3) uniform samplerCube uEnvMap;

layout(set = 0, binding = 4) uniform sampler2D uAlbedo;
layout(set = 0, binding = 5) uniform sampler2D uNormal;
layout(set = 0, binding = 6) uniform sampler2D uMaterial;
layout(set = 0, binding = 7) uniform sampler2D uLinearDepth;

layout(push_constant) uniform PC
{
    uint width;
    uint height;
    int maxSteps;
    float maxDistance;
    float strideScale;
    float thickness;
    int binaryIters;
    float roughnessThreshold;
    float prefilterMaxMip;
} pc;

const float EPS = 1e-6;
const float DEPTH_INVALID = 1e6;
const float PI = 3.14159265359;

vec3 reconstructViewDir(vec2 uv)
{
    vec2 ndcxy = uv * 2.0 - 1.0;
    vec4 clip = vec4(ndcxy, 1.0, 1.0);
    vec4 v = camera.invProj * clip;
    vec3 dir = normalize(v.xyz);
    return dir;
}

// reconstruct view space position from screen uv and non-linear depth (vulkan depth 0..1)
vec3 reconstructViewPosition(vec2 uv, float depth)
{
    vec3 ndc;
    ndc.xy = uv * 2.0 - 1.0;
    ndc.z = depth;
    vec4 clip = vec4(ndc, 1.0);
    vec4 viewPos = camera.invProj * clip;
    viewPos /= viewPos.w;
    return viewPos.xyz;
}

vec3 reconstructViewPositionLinear(vec2 uv, float linearDepth)
{
    vec3 dir = reconstructViewDir(uv);
    return dir * linearDepth;
}

// project view space position to screen uv and view space z
vec3 projectViewPosToScreenUV(vec3 viewPos)
{
    vec4 clip = camera.proj * vec4(viewPos, 1.0);
    if (clip.w <= 0.0)
    {
        return vec3(-1.0);
    }

    vec3 ndc = clip.xyz / clip.w;
    vec2 uv = ndc.xy * 0.5 + 0.5;
    float viewDist = -viewPos.z;
    return vec3(uv, viewDist);
}

float sampleSceneViewDistLinear(vec2 uv)
{
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0))))
    {
        return 1e6;
    }
    float linearDepth=texture(uLinearDepth, uv).r;
    return linearDepth;
}

float sampleSceneViewDistLinearSafe(vec2 sUV)
{
    if (any(lessThan(sUV, vec2(0.0))) || any(greaterThan(sUV, vec2(1.0))))
    {
        return DEPTH_INVALID;
    }
    float ld = texture(uLinearDepth, sUV).r;
    if (ld <= 0.0)
    {
        return DEPTH_INVALID;
    }
    return ld;
}

// sample color at uv from lit image
vec3 sampleSceneColor(vec2 uv, float roughness)
{
    // Based on roughness, sample multiple pixels around hit point
    if (roughness < 0.05)
    {
        // Very smooth: single sample
        return texture(uLitMap, uv).rgb;
    }

    // Calculate sample radius based on roughness
    float radius = roughness * roughness * 0.01;  // Non-linear for better control

    // Poisson-like sampling pattern (4 samples)
    vec2 offsets[4] = vec2[](
        vec2(-1.0, -1.0),
        vec2(1.0, -1.0),
        vec2(-1.0, 1.0),
        vec2(1.0, 1.0)
    );

    vec3 sum = texture(uLitMap, uv).rgb * 2.0;  // Center sample with higher weight
    float totalWeight = 2.0;

    for (int i = 0; i < 4; i++)
    {
        vec2 sampleUV = uv + offsets[i] * radius;
        // Clamp to valid UV range
        sampleUV = clamp(sampleUV, vec2(0.0), vec2(1.0));
        sum += texture(uLitMap, sampleUV).rgb;
        totalWeight += 1.0;
    }

    return sum / totalWeight;
}

// convert view sapce direction  R_view to world direction for envMap sampling
vec3 viewDirToWorld(vec3 dirView)
{
    return normalize((camera.invView * vec4(dirView, 0.0)).xyz);
}

vec3 sampleNormalView(vec2 sUV)
{
    vec3 nS = texture(uNormal, sUV).xyz;
    vec3 n_view = normalize((camera.view * vec4(nS, 0.0)).xyz);
    return n_view;
}

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pix, ivec2(pc.width, pc.height))))
    {
        return;
    }

    vec2 uv = (vec2(pix) + 0.5) / vec2(pc.width, pc.height);


    float linearDepth = texture(uLinearDepth, uv).r;

    if (linearDepth <= 0.0 || linearDepth >= 1000.f)
    {
        vec3 dirView = reconstructViewDir(uv);
        vec3 R_world = viewDirToWorld(dirView);
        vec3 envCol = textureLod(uEnvMap, R_world, 0.0).rgb;
        imageStore(outSSR, pix, vec4(envCol, 0.0));
        return;
    }

    vec3 viewPos = reconstructViewPositionLinear(uv, linearDepth);

    vec3 N = texture(uNormal, uv).xyz;
    vec3 nrm = normalize(N);

    vec3 N_View = normalize((camera.view * vec4(nrm, 0.0)).xyz);

    vec3 V = normalize(-viewPos);
    vec4 mat = texture(uMaterial, uv);
    float roughness = mat.g;

    if (roughness > pc.roughnessThreshold)
    {
        vec3 R_world = viewDirToWorld(reflect(-V, N_View));
        float mip = clamp(roughness, 0.0, 1.0) * pc.prefilterMaxMip;
        vec3 envCol = textureLod(uEnvMap, R_world, mip).rgb;
        imageStore(outSSR, pix, vec4(envCol, 0.0));
        return;
    }

    vec3 R_View = normalize(reflect(-V, N_View));

    float viewDist = -viewPos.z;
    float minWorldStep = 0.02;
    //    {
    //        vec3 p1 = viewPos + R_View * 0.05;
    //        vec3 proj1 = projectViewPosToScreenUV(p1);
    //        vec3 proj0 = projectViewPosToScreenUV(viewPos);
    //
    //        if (proj1.z > 0.0 && proj0.z > 0.0)
    //        {
    //            float pixelData = length((proj1.xy - proj0.xy) * vec2(pc.width, pc.height));
    //            if (pixelData > EPS)
    //            {
    //                float scale = 1.0 / pixelData;
    //                minWorldStep = clamp(scale * pc.strideScale, 0.01, 0.5);
    //            }
    //        }
    //    }
    float t = minWorldStep;
    float maxDist = pc.maxDistance;
    int maxSteps = pc.maxSteps;
    float baseThickness = max(pc.thickness, 0.05);
    int binaryIters = pc.binaryIters;
    float stride = max(0.5 * maxDist / float(maxSteps), 0.001) * pc.strideScale;

    float thickness = baseThickness + roughness * 0.05 + viewDist * 0.00015;

    float rejectPixelRadius = clamp(roughness * 3.0 + 1.0, 1.0, 6.0);

    bool hit = false;
    float hitT = 0.0;
    vec2 hitUV = vec2(0.0);

    for (int i = 0; i < maxSteps && t < maxDist; i++)
    {
        vec3 samplePos = viewPos + R_View * t;
        vec3 proj = projectViewPosToScreenUV(samplePos);
        if (proj.z <= 0.0)
        {
            t += stride;
            continue;
        }
        vec2 suv = proj.xy;
        if (any(lessThan(suv, vec2(0.0))) || any(greaterThan(suv, vec2(1.0))))
        {
            t += stride;
            continue;
        }

        float sceneDist = sampleSceneViewDistLinearSafe(suv);
        if (sceneDist == DEPTH_INVALID)
        {
            t += stride;
            continue;
        }
        float sampleDist = proj.z;// weird but sampleDist means this sample ray's hit position, sceneDist means the sample from uLinearDepth

        if (sceneDist < sampleDist - thickness)
        {
            float t0 = max(0.0, t - stride);
            float t1 = t;
            for (int b = 0; b < binaryIters; ++b)
            {
                float tm = 0.5 * (t0 + t1);
                vec3 midPos = viewPos + R_View * tm;
                vec3 midProj = projectViewPosToScreenUV(midPos);
                if (midProj.z <= 0.0)
                {
                    t0 = tm;
                    continue;
                }
                vec2 muv = midProj.xy;
                if (any(lessThan(muv, vec2(0.0))) || any(greaterThan(muv, vec2(1.0))))
                {
                    t0 = tm;
                    continue;
                }
                float  pxDistm = length((muv - uv) * vec2(pc.width, pc.height));
                if (pxDistm < max(rejectPixelRadius * 0.5, 1.0))
                {
                    t0 = tm;
                    continue;
                }
                float midSceneDist = sampleSceneViewDistLinearSafe(muv);
                if (midSceneDist == DEPTH_INVALID)
                {
                    t0 = tm;
                    continue;
                }
                float midSampleDist = midProj.z;
                if (midSceneDist < midSampleDist - thickness)
                {
                    t1 = tm;
                }
                else
                {
                    t0 = tm;
                }
            }
            hitT = 0.5 * (t0 + t1);
            vec3 pHit = viewPos + R_View * hitT;
            vec3 projHit = projectViewPosToScreenUV(pHit);
            //            hitUV = projHit.xy;
            //            hit = true;
            //            break;
            if (projHit.z > 0.0)
            {
                vec2 finalUV = projHit.xy;

                float pxDist = length((finalUV - uv) * vec2(pc.width, pc.height));
                if (pxDist < 1.0)
                {
                    t += stride;
                    continue;
                }

                vec3 nHitView = sampleNormalView(finalUV);
                float nDotR = dot(nHitView, -normalize(R_View));
                if (nDotR < 0.3)
                {
                    t += stride;
                    continue;
                }

                float sceneDistAtHit = sampleSceneViewDistLinearSafe(finalUV);
                if (sceneDistAtHit == DEPTH_INVALID || sceneDistAtHit > viewDist + maxDist)
                {
                    t += stride;
                    continue;
                }

                hitUV = finalUV;
                hit = true;
                break;
            }
        }
        t += stride;
    }

    vec3 outColor = vec3(0.0);
    float hitMask = 0.0;

    if (hit)
    {
        outColor = sampleSceneColor(hitUV, roughness);
        hitMask = 1.0;
    }
    else
    {
        vec3 R_world = viewDirToWorld(R_View);
        float mip = clamp(roughness, 0.0, 1.0) * pc.prefilterMaxMip;
        outColor = textureLod(uEnvMap, R_world, mip).rgb;
    }
    imageStore(outSSR, pix, vec4(outColor, hitMask));
}