#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std140, binding = 0) uniform uboCamera {
    mat4 view;
    mat4 proj;
    mat4 viewNoTrans;
    mat4 invView;
    mat4 invProj;
} camera;
layout(std140, binding = 1) uniform uboShadow {
    mat4 view;
    mat4 proj;
} shadow;
layout(std140, binding = 2) uniform lightParms {
    vec2 viewport;
    vec2 _pad0;
    vec3 sunDir;
    float sunIntensity;
    vec3 sunColor;
    float _pad1;
} lightParm;

// output
layout (set = 0, binding = 3, rgba16f) uniform image2D outImage;

// G-buffer samplers
layout(set = 0, binding = 4) uniform sampler2D uAlbedo;
layout(set = 0, binding = 5) uniform sampler2D uNormal;
layout(set = 0, binding = 6) uniform sampler2D uMaterial;
layout(set = 0, binding = 7) uniform sampler2D uDepth;
// shadow map - use sampler2DShadow with compare enabled on Vulkan side for hardware PCF
layout(set = 0, binding = 8) uniform sampler2DShadow uShadowMap;

const float PI = 3.14159265359;

// --- helpers ---
//vec3 reconstructWorldPosition(vec2 uv, float depth) {
//    // depth from depth buffer in [0,1]
//    vec4 ndcPos = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
//    vec4 viewPos = camera.invProj * ndcPos;
//    // perspective divide
//    viewPos /= viewPos.w;
//    vec4 worldPos = camera.invView * viewPos;
//    return worldPos.xyz;
//}

vec3 reconstructWorldPosition(vec2 uv, float depth) {
    // depth assumed in [0,1] (Vulkan). NDC.xy in [-1,1], NDC.z in [0,1]
    vec3 ndc;
    ndc.xy = uv * 2.0 - 1.0;
    ndc.z = depth;// **Vulkan**: depth already 0..1
    vec4 clip = vec4(ndc, 1.0);// clip.w = 1 here; note we treat as (x,y,z,1)
    vec4 viewPos = camera.invProj * clip;
    viewPos /= viewPos.w;
    vec4 worldPos = camera.invView * viewPos;
    return worldPos.xyz;
}

//vec3 getShadowPos(vec3 worldPos) {
//    vec4 sp = shadow.proj * shadow.view * vec4(worldPos, 1.0);
//    sp /= sp.w;
//    return sp.xyz * 0.5 + 0.5;// map [-1,1] to [0,1]
//}
vec3 getShadowPos(vec3 worldPos) {
    vec4 sp = shadow.proj * shadow.view * vec4(worldPos, 1.0);
    sp /= sp.w;
    // Vulkan proj produces NDC.z in [0,1], so we do NOT remap z.
    // uv for sampler (normalized) is (sp.xy*0.5+0.5) only if your proj gives xy in [-1,1].
    // For XY we still need to map from NDC[-1,1] -> [0,1].
    vec2 uv = sp.xy * 0.5 + 0.5;
    return vec3(uv, sp.z);
}

// GGX D
float D_GGX(float NdH, float rough) {
    float a = rough * rough;
    float a2 = a * a;
    float denom = (NdH * NdH) * (a2 - 1.0) + 1.0;
    return a2 / (PI * denom * denom + 1e-5);
}

// Schlick Fresnel
vec3 F_Schlick(float VdotH, vec3 F0) {
    return F0 + (1.0 - F0) * pow(1.0 - VdotH, 5.0);
}

// Schlick geometric (single term)
float G_Schlick(float NdotV, float k) {
    return NdotV / (NdotV * (1.0 - k) + k + 1e-5);
}

// Smith combined
float G_Smith(float NdotV, float NdotL, float rough) {
    float r = (rough + 1.0);
    float k = (r * r) / 8.0;
    return G_Schlick(NdotV, k) * G_Schlick(NdotL, k);
}

// 3x3 PCF using sampler2DShadow (hardware compare if sampler was created with compareEnable = true).
// Assumes uShadowMap is sampler2DShadow and the Vulkan sampler has linear filtering.
// Returns visibility (1.0 = fully lit, 0.0 = fully in shadow).
float ComputeShadowPCF(vec3 shadowPos, float NdotL)
{
    vec2 uv = shadowPos.xy;
    float currentDepth = shadowPos.z;

    // outside shadow frustum -> lit
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0 || currentDepth <= 0.0 || currentDepth >= 1.0)
    return 1.0;

    // texel size (handle non-square shadow maps)
    ivec2 ts = textureSize(uShadowMap, 0);
    vec2 texel = 1.0 / vec2(max(ts.x, 1), max(ts.y, 1));

    // radius in UV units (1.0 means one texel)
    float radius = 1.0;// sample +-1 texel
    vec2 rvec = texel * radius;

    // bias (simple NdotL based bias -- tune per scene)
    float bias = max(0.0005, 0.05 * (1.0 - NdotL));

    // offsets for 3x3
    vec2 offs[9] = vec2[](
    vec2(-1.0, -1.0), vec2(0.0, -1.0), vec2(1.0, -1.0),
    vec2(-1.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0),
    vec2(-1.0, 1.0), vec2(0.0, 1.0), vec2(1.0, 1.0)
    );

    float sum = 0.0;
    for (int i = 0; i < 9; ++i) {
        vec2 sampleUV = uv + offs[i] * rvec;
        // clamp sampleUV to [0,1] to avoid border issues (sampler set to clamp would also handle)
        sampleUV = clamp(sampleUV, vec2(0.0), vec2(1.0));
        // sampler2DShadow compare: parameter is vec3(uv, refDepth)
        float cmp = texture(uShadowMap, vec3(sampleUV, currentDepth));
        sum += cmp;
    }

    return sum / 9.0;
}

void main(){
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 vp = ivec2(int(lightParm.viewport.x), int(lightParm.viewport.y));
    if (pix.x >= vp.x || pix.y >= vp.y) {
        return;
    }

    vec2 uv = (vec2(pix) + 0.5) / lightParm.viewport;

    // sample G-buffer
    vec4 alb = texture(uAlbedo, uv);
    vec3 albedo = alb.rgb;

    float depth = texture(uDepth, uv).r;

    if (depth >= 0.9999) {
        // background (sky) - no lighting
        imageStore(outImage, pix, vec4(albedo, 1.0));
        return;
    }
    // Normal sampling:
    // If you stored normal as signed float texture (R16G16B16_SFLOAT), sampled values can be -1..1.
    // If you encoded into 0..1, you would need decode = n*2-1.
    vec3 nSample = texture(uNormal, uv).xyz;
    vec3 nrm;
    // heuristic: if all components are in [0,1] and likely encoded, decode; otherwise assume stored as signed floats
    //    if (all(greaterThanEqual(nSample, vec3(0.0))) && all(lessThanEqual(nSample, vec3(1.0)))) {
    //        // encoded [0,1] -> decode to [-1,1]
    //        nrm = normalize(nSample * 2.0 - 1.0);
    //    }
    //    else {
    nrm = normalize(nSample);
    //     }

    vec4 mat = texture(uMaterial, uv);
    float metallic = clamp(mat.r, 0.0, 1.0);
    float roughness = clamp(mat.g, 0.04, 1.0);
    // specTrans not used in this simple direct-light pass
    // float specTrans = mat.b;

    vec3 worldPos = reconstructWorldPosition(uv, depth);
    vec3 shadowPos = getShadowPos(worldPos);

    // viewer (camera) world position
    vec3 camPos = (camera.invView * vec4(0.0, 0.0, 0.0, 1.0)).xyz;

    // light direction (assume normalized and pointing from surface to light)
    vec3 L = normalize(lightParm.sunDir);
    vec3 V = normalize(camPos - worldPos);
    vec3 H = normalize(L + V);

    float NdotL = max(dot(nrm, L), 0.0);
    float NdotV = max(dot(nrm, V), 1e-5);
    float VdotH = max(dot(V, H), 0.0);
    float NdotH = max(dot(nrm, H), 0.0);

    // Cook-Torrance BRDF
    vec3 F0 = mix(vec3(0.04), albedo, metallic);
    float D = D_GGX(NdotH, roughness);
    float G = G_Smith(NdotV, NdotL, roughness);
    vec3 F = F_Schlick(VdotH, F0);

    vec3 numerator = D * G * F;
    float denom = max(4.0 * NdotV * NdotL, 1e-5);
    vec3 specular = numerator / denom;

    vec3 kD = (vec3(1.0) - F) * (1.0 - metallic);
    vec3 diffuse = (kD * albedo) / PI;

    // incoming radiance (directional light)
    vec3 radiance = lightParm.sunColor * lightParm.sunIntensity;

    // direct (unshadowed) contribution
    vec3 Lo = (diffuse + specular) * radiance * NdotL;

    // ambient (simple)
    vec3 ambient = vec3(0.03) * albedo;

    // shadow visibility
    float visibility = 1.0;
    if (NdotL > 0.0) {
        visibility = ComputeShadowPCF(shadowPos, NdotL);
    }

    vec3 color = ambient + Lo * visibility;

    imageStore(outImage, pix, vec4(color, 1.0));
}