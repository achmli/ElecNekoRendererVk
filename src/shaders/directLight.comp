#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std140, binding = 0) uniform uboCamera {
    mat4 view;
    mat4 proj;
    mat4 viewNoTrans;
    mat4 invView;
    mat4 invProj;
}
camera;
layout(std140, binding = 1) uniform uboShadowView {
    mat4 cascade0;
    mat4 cascade1;
    mat4 cascade2;
    mat4 cascade3;
}
shadowView;
layout(std140, binding = 2) uniform uboShadowProj {
    mat4 cascade0;
    mat4 cascade1;
    mat4 cascade2;
    mat4 cascade3;
}
shadowProj;
layout(std140, binding = 3) uniform lightParms {
    vec2 viewport;
    vec2 _pad0;
    vec3 sunDir;
    float sunIntensity;
    vec3 sunColor;
    float _pad1;
}
lightParm;
layout(std140, binding = 4) uniform cascadeParms {
    float splits0;
    float splits1;
    float splits2;
    float splits3;
    float splits4;
    float texelSize;
    uint numCascades;
    int visualizeCascade;
}
shadowParm;

// output
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D outImage;
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D outImageSpecular;

// G-buffer samplers
layout(set = 0, binding = 7) uniform sampler2D uAlbedo;
layout(set = 0, binding = 8) uniform sampler2D uNormal;
layout(set = 0, binding = 9) uniform sampler2D uMaterial;
layout(set = 0, binding = 10) uniform sampler2D uLinearDepth;
layout(set = 0, binding = 11) uniform sampler2D uDepth;
layout(set = 0, binding = 12) uniform samplerCube uEnvMap;
layout(set = 0, binding = 13) uniform sampler2D uAO;
// shadow map - use sampler2DShadow with compare enabled on Vulkan side for hardware PCF
layout(set = 0, binding = 14) uniform sampler2DShadow uShadowCascade0;
layout(set = 0, binding = 15) uniform sampler2DShadow uShadowCascade1;
layout(set = 0, binding = 16) uniform sampler2DShadow uShadowCascade2;
layout(set = 0, binding = 17) uniform sampler2DShadow uShadowCascade3;

layout(push_constant) uniform PC {
    int useAO;
    int useContactShadow;
}
pc;

