// csm helpers
int ChooseCascade(float viewDepth) {
    int nc = int(shadowParm.numCascades);
    if (nc <= 1)
    return 0;
    if (viewDepth <= shadowParm.splits1)
    return 0;
    if (nc >= 3 && viewDepth <= shadowParm.splits2)
    return 1; // [split1,split2] second cascade. so cascade2
    if (nc >= 4 && viewDepth <= shadowParm.splits3)
    return 2; // [split2,split3] third cascade. so cascade3
    return max(0, nc - 1);
}

vec3 CalcShadowPosForCascade(vec3 worldPos, int cascadeIndex) {
    mat4 sv;
    mat4 sp;
    if (cascadeIndex == 0) {
        sv = shadowView.cascade0;
        sp = shadowProj.cascade0;
    }
    else if (cascadeIndex == 1) {
        sv = shadowView.cascade1;
        sp = shadowProj.cascade1;
    }
    else if (cascadeIndex == 2) {
        sv = shadowView.cascade2;
        sp = shadowProj.cascade2;
    }
    else {
        sv = shadowView.cascade3;
        sp = shadowProj.cascade3;
    }

    vec4 clip = sp * sv * vec4(worldPos, 1.0);
    if (abs(clip.w) < 1e-6) {
        return vec3(-1.0, -1.0, -1.0);
    }
    vec3 ndc = clip.xyz / clip.w;
    vec2 uv = ndc.xy * 0.5 + 0.5;
    float z = ndc.z;
    return vec3(uv, z);
}

float ComputeShadowPCFForCascade(vec3 shadowPos, float NdotL, int cascadeIndex) {
    vec2 uv = shadowPos.xy;
    float currentDepth = shadowPos.z;

    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0 || currentDepth <= 0.0 || currentDepth >= 1.0) {
        return 1.0;
    }

    ivec2 ts;
    // float bias = max(0.0005, 0.05 * (1.0 - NdotL));
    // float bias = max(0.0005, shadowParm.texelSize * 2.0 * (1.0 - NdotL));// texelSize is 1.0 / shadowMapResolution
    float bias = 0.001;
    vec2 offs[9] = vec2[](vec2(-1.0, -1.0), vec2(0.0, -1.0), vec2(1.0, -1.0), vec2(-1.0, 0.0), vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(-1.0, 1.0), vec2(0.0, 1.0),
        vec2(1.0, 1.0));

    float sum = 0.0;
    if (cascadeIndex == 0) {
        ts = textureSize(uShadowCascade0, 0);
        vec2 texel = 1.0 / vec2(max(ts.x, 1), max(ts.y, 1));
        for (int i = 0; i < 9; i++) {
            vec2 sampleUV = clamp(uv + offs[i] * texel, vec2(0.0), vec2(1.0));
            float cmp = texture(uShadowCascade0, vec3(sampleUV, currentDepth - bias));
            sum += cmp;
        }
    }
    else if (cascadeIndex == 1) {
        ts = textureSize(uShadowCascade1, 0);
        vec2 texel = 1.0 / vec2(max(ts.x, 1), max(ts.y, 1));
        for (int i = 0; i < 9; i++) {
            vec2 sampleUV = clamp(uv + offs[i] * texel, vec2(0.0), vec2(1.0));
            float cmp = texture(uShadowCascade1, vec3(sampleUV, currentDepth - bias));
            sum += cmp;
        }
    }
    else if (cascadeIndex == 2) {
        ts = textureSize(uShadowCascade2, 0);
        vec2 texel = 1.0 / vec2(max(ts.x, 1), max(ts.y, 1));
        for (int i = 0; i < 9; i++) {
            vec2 sampleUV = clamp(uv + offs[i] * texel, vec2(0.0), vec2(1.0));
            float cmp = texture(uShadowCascade2, vec3(sampleUV, currentDepth - bias));
            sum += cmp;
        }
    }
    else {
        ts = textureSize(uShadowCascade3, 0);
        vec2 texel = 1.0 / vec2(max(ts.x, 1), max(ts.y, 1));
        for (int i = 0; i < 9; i++) {
            vec2 sampleUV = clamp(uv + offs[i] * texel, vec2(0.0), vec2(1.0));
            float cmp = texture(uShadowCascade3, vec3(sampleUV, currentDepth - bias));
            sum += cmp;
        }
    }

    return sum / 9.0;
}

float ComputeCSMVisibility(vec3 worldPos, float NdotL, vec2 uv) {
    float viewDepth = texture(uLinearDepth, uv).r;

    int cascade = ChooseCascade(viewDepth);

    int nc = int(shadowParm.numCascades);
    if (cascade >= nc)
    cascade = max(0, nc - 1);

    vec3 sp = CalcShadowPosForCascade(worldPos, cascade);

    if (sp.z < 0.0 || sp.z > 1.0) {
        return 1.0;
    }

    return ComputeShadowPCFForCascade(sp, NdotL, cascade);
}

// GGX D
float D_GGX(float NdH, float rough) {
    float a = rough * rough;
    float a2 = a * a;
    float denom = (NdH * NdH) * (a2 - 1.0) + 1.0;
    return a2 / (PI * denom * denom + 1e-5);
}

// Schlick Fresnel
vec3 F_Schlick(float VdotH, vec3 F0) {
    return F0 + (1.0 - F0) * pow(1.0 - VdotH, 5.0);
}

// Schlick geometric (single term)
float G_Schlick(float NdotV, float k) {
    return NdotV / (NdotV * (1.0 - k) + k + 1e-5);
}

// Smith combined
float G_Smith(float NdotV, float NdotL, float rough) {
    float r = (rough + 1.0);
    float k = (r * r) / 8.0;
    return G_Schlick(NdotV, k) * G_Schlick(NdotL, k);
}

