vec3 getWorldDirFromUV(vec2 uv) {
    vec3 ndc;
    ndc.xy = uv * 2.0 - 1.0;
    ndc.z = 1.0; // looking forward in view space

    vec4 clip = vec4(ndc, 1.0);

    vec4 viewPos = camera.invProj * clip;
    viewPos /= viewPos.w;

    vec3 dirView = normalize(vec3(viewPos.x, viewPos.y, viewPos.z));

    vec3 dirWorld = (camera.invView * vec4(dirView, 0.0)).xyz;
    return normalize(dirWorld);
}

// ssct
float ScreenSpaceContactShadow(vec3 viewPos, vec3 N) {
    const float MAX_DIST = 0.08; // 减小搜索范围
    const float START_OFFSET = 0.002;

    // 调试参数 - 可以暴露为uniform
    const float DEPTH_BIAS = 0.0005; // 非常小的偏差
    const float INTENSITY = 0.8; // 阴影强度

    float t = START_OFFSET;
    float shadow = 1.0;

    vec3 samplePosView = viewPos + N * t;

    // 投影到裁剪空间
    vec4 clip = camera.proj * vec4(samplePosView, 1.0);
    if (clip.w <= 0.0) {
        return 1.0;
    }

    // 转换为NDC和UV
    vec3 ndc = clip.xyz / clip.w;
    vec2 sampleUV = ndc.xy * 0.5 + 0.5;

    // 检查是否在屏幕内
    if (any(lessThan(sampleUV, vec2(0.0))) || any(greaterThan(sampleUV, vec2(1.0)))) {
        return 1.0;
    }

    // 采样深度
    float sceneDepth = texture(uDepth, sampleUV).r;

    // 重建场景点的视图空间位置
    vec4 clip_scene = vec4(ndc.xy, sceneDepth, 1.0);
    vec4 viewPos_scene = camera.invProj * clip_scene;
    viewPos_scene /= viewPos_scene.w;

    // 计算深度差异（使用线性深度）
    float sampleDepth = -samplePosView.z; // 采样点深度
    float sceneDepthLinear = -viewPos_scene.z; // 场景点深度

    float depthDiff = sampleDepth - sceneDepthLinear;

    // 检测遮挡（使用很小的偏差）
    if (depthDiff > DEPTH_BIAS) {
        // 简单的硬阴影
        return 1.0 - INTENSITY;
    }

    return 1.0; // 无遮挡
}

float SmallSceneContactShadow(vec3 viewPos, vec3 N) {
    const float SAMPLE_DISTANCE = 0.02;
    vec3 viewDir = normalize(-viewPos);

    float slope = tan(acos(dot(N, viewDir)));

    ivec2 despthMapSize = textureSize(uDepth, 0);
    float texelSize = 1.0 / float(max(despthMapSize.x, despthMapSize.y));
    float baseBias = texelSize * 2.0;

    float slopeBias = baseBias * slope * 0.5;

    float fixedBias = 0.001;

    float totalBias = fixedBias + slopeBias;

    vec3 biasedViewPos = viewPos + N * totalBias;
    vec3 samplePosView = biasedViewPos + N * SAMPLE_DISTANCE;

    vec4 clip = camera.proj * vec4(samplePosView, 1.0);
    if (clip.w <= 0.0) {
        return 1.0;
    }

    vec3 ndc = clip.xyz / clip.w;
    vec2 sampleUV = ndc.xy * 0.5 + 0.5;

    if (any(lessThan(sampleUV, vec2(0.0))) || any(greaterThan(sampleUV, vec2(1.0)))) {
        return 1.0;
    }

    float sceneDepth = texture(uDepth, sampleUV).r;
    vec4 clipScene = vec4(ndc.xy, sceneDepth, 1.0);
    vec4 viewPosScene = camera.invProj * clipScene;
    viewPosScene /= viewPosScene.w;

    float depthDiff = (-samplePosView.z) - (-viewPosScene.z);

    if (depthDiff > totalBias * 2.0) {
        return 0.0;
    }

    return 1.0;
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 vp = ivec2(int(lightParm.viewport.x), int(lightParm.viewport.y));
    if (pix.x >= vp.x || pix.y >= vp.y) {
        return;
    }

    vec2 uv = (vec2(pix) + 0.5) / lightParm.viewport;

    // sample G-buffer
    vec4 alb = texture(uAlbedo, uv);
    vec3 albedo = alb.rgb;

    float depth = texture(uDepth, uv).r;

    if (depth >= 0.9999) {
        // background (sky) - no lighting
        vec3 viewDirWorld = getWorldDirFromUV(uv);

        vec3 skyColor = textureLod(uEnvMap, viewDirWorld, 0.0).rgb;

        // diffuse = skyColor, alpha = 1.0
        imageStore(outImage, pix, vec4(skyColor, 1.0));
        // specular = 0, roughness = 1.0
        imageStore(outImageSpecular, pix, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }
    // Normal sampling:
    // If you stored normal as signed float texture (R16G16B16_SFLOAT), sampled values can be -1..1.
    // If you encoded into 0..1, you would need decode = n*2-1.
    vec3 nSample = texture(uNormal, uv).xyz;
    vec3 nrm;
    // heuristic: if all components are in [0,1] and likely encoded, decode; otherwise assume stored as signed floats
    //    if (all(greaterThanEqual(nSample, vec3(0.0))) && all(lessThanEqual(nSample, vec3(1.0)))) {
    //        // encoded [0,1] -> decode to [-1,1]
    //        nrm = normalize(nSample * 2.0 - 1.0);
    //    }
    //    else {
    nrm = normalize(nSample);
    //     }

    vec4 mat = texture(uMaterial, uv);
    float metallic = clamp(mat.r, 0.0, 1.0);
    float roughness = clamp(mat.g, 0.04, 1.0);
    // specTrans not used in this simple direct-light pass
    // float specTrans = mat.b;

    vec3 worldPos = reconstructWorldPosition(uv, depth);
    // vec3 shadowPos = getShadowPos(worldPos);

    // viewer (camera) world position
    vec3 camPos = (camera.invView * vec4(0.0, 0.0, 0.0, 1.0)).xyz;

    // light direction (assume normalized and pointing from surface to light)
    vec3 L = normalize(lightParm.sunDir);
    vec3 V = normalize(camPos - worldPos);
    vec3 H = normalize(L + V);

    float NdotL = max(dot(nrm, L), 0.0);
    float NdotV = max(dot(nrm, V), 1e-5);
    float VdotH = max(dot(V, H), 0.0);
    float NdotH = max(dot(nrm, H), 0.0);

    // Cook-Torrance BRDF
    vec3 F0 = mix(vec3(0.04), albedo, metallic);
    float D = D_GGX(NdotH, roughness);
    float G = G_Smith(NdotV, NdotL, roughness);
    vec3 F = F_Schlick(VdotH, F0);

    vec3 numerator = D * G * F;
    float denom = max(4.0 * NdotV * NdotL, 1e-5);
    vec3 specular = numerator / denom;

    vec3 kD = (vec3(1.0) - F) * (1.0 - metallic);
    vec3 diffuse = (kD * albedo) / PI;

    // incoming radiance (directional light)
    vec3 radiance = lightParm.sunColor * lightParm.sunIntensity;

    // direct (unshadowed) contribution
    // vec3 Lo = (diffuse + specular) * radiance * NdotL;
    vec3 directDiffuse = diffuse * radiance * NdotL;
    vec3 directSpecular = specular * radiance * NdotL;

    // ambient (simple)
    vec3 ambient = vec3(0.03) * albedo;

    // shadow visibility
    float visibility = 1.0;
    if (NdotL > 0.0) {
        visibility = ComputeCSMVisibility(worldPos, NdotL, uv);
    }
    directDiffuse *= visibility;
    directSpecular *= visibility;

    // vec3 color = ambient + Lo * visibility;
    //  IBL contribution -----------------------------------
    //     vec3 irradiance = textureLod(uEnvMap, nrm, 4.5).rgb;
    //     vec3 diffuseIBL = irradiance * albedo;
    //
    //     vec3 R = reflect(-V, nrm);
    //
    //     float mip = clamp(roughness, 0.0, 1.0) * 9.0;
    //     vec3 prefilterColor = textureLod(uEnvMap, R, mip).rgb;
    //
    //     vec3 F_ibl = F_Schlick(max(dot(nrm, V), 0.0), F0);
    //     vec3 specIBL = prefilterColor * F_ibl;// * envBRDF.x + envBRDF.y;
    //
    //     vec3 kD_ibl = (vec3(1.0) - F_ibl) * (1.0 - metallic);
    //
    //     vec3 iblColor = kD_ibl * diffuseIBL + specIBL;

    // baseline IBL
    // diffuse IBL
    vec3 irradiance = textureLod(uEnvMap, nrm, 4.0).rgb;
    vec3 diffuseIBL = irradiance * albedo;

    // specular IBL
    vec3 R = reflect(-V, nrm);
    // Use squared roughness for more aggressive blurring at low roughness
    float mip = roughness * roughness * 11.0;
    vec3 prefilterColor = textureLod(uEnvMap, R, mip).rgb;

    vec3 F_ibl = F_Schlick(max(dot(nrm, V), 0.0), F0);
    // For metals, strongly blend with albedo to preserve metal color against blue environment
    vec3 F_colored = mix(F_ibl, albedo, metallic * 0.7);
    vec3 specIBL = prefilterColor * F_colored;

    // Energy conservation for IBL: separate diffuse and specular
    kD = (vec3(1.0) - F_ibl) * (1.0 - metallic);
    vec3 iblDiffuse = kD * diffuseIBL;
    vec3 iblSpecular = specIBL;

    // ao and ct
    float ao = texture(uAO, uv).r;

    vec3 viewPosPixel = (camera.view * vec4(worldPos, 1.0)).xyz;
    vec3 N_view = normalize((camera.view * vec4(nrm, 0.0)).xyz);
    float contact = ScreenSpaceContactShadow(viewPosPixel, N_view);

    // Ambient + Direct Diffuse + IBL Diffuse (all in diffuse buffer)
    vec3 diffuseAndAmbient = pc.useAO > 0 ? (ambient + diffuse + iblDiffuse) * ao : (ambient + diffuse + iblDiffuse);

    vec3 directLight = pc.useContactShadow > 0 ? directDiffuse * visibility * contact : directDiffuse * visibility;

    vec3 outDiffuseRGB = diffuseAndAmbient + directLight;

    // Direct Specular + IBL Specular (all in specular buffer)
    // Note: directSpecular already multiplied by visibility at line 518
    vec3 outSpecularRGB = directSpecular + iblSpecular;

    if (shadowParm.visualizeCascade > 0) {
        // cascade visualize
        float overlayStrength = 0.6;
        vec4 cascadeColors[4];
        cascadeColors[0] = vec4(1.0, 0.0, 0.0, 1.0);
        cascadeColors[1] = vec4(0.0, 1.0, 0.0, 1.0);
        cascadeColors[2] = vec4(0.0, 0.0, 1.0, 1.0);
        cascadeColors[3] = vec4(1.0, 1.0, 0.0, 1.0);

        float viewDepth = texture(uLinearDepth, uv).r;
        int cascadeIdx = ChooseCascade(viewDepth);

        vec3 cascadeCol = cascadeColors[clamp(cascadeIdx, 0, 3)].rgb;
        outDiffuseRGB = mix(outDiffuseRGB, cascadeCol, overlayStrength);
    }

    imageStore(outImage, pix, vec4(outDiffuseRGB, ao));
    imageStore(outImageSpecular, pix, vec4(outSpecularRGB, roughness));
}
